{
  "schemaVersion": 1,
  "id": "clientcommands",
  "name": "Silly Client Commands",
  "description": "Useful client-side commands",
  "version": "${version}",
  "environment": "*",
  "license": "LGPL-3.0-or-later",
  "icon": "assets/clientcommands/icon.png",
  "contact": {
    "homepage": "https://earthcomputer.net/",
    "issues": "https://github.com/Earthcomputer/clientcommands/issues",
    "sources": "https://github.com/Earthcomputer/clientcommands"
  },
  "authors": [
    "Earthcomputer"
  ],
  "contributors": [
    "cortex",
    "haykam",
    "xpple"
  ],
  "entrypoints": {
    "client": [
      "net.earthcomputer.clientcommands.ClientCommands"
    ],
    "main": [
      "net.earthcomputer.clientcommands.server.ClientCommandsServer"
    ]
  },
  "depends": {
    "minecraft": "${mcversion}",
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "betterconfig": "*",
    "clientarguments": "*",
    "simplewaypoints": "*"
  },
  "mixins": [
    {
      "config": "mixins.clientcommands.json",
      "environment": "client"
    }
  ],
  "accessWidener": "clientcommands.aw",
  "custom": {
    "modmenu": {
      "update_checker": true
    }
  }
}
